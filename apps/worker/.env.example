# Environment of apps/worker. Validated with zod at startup (src/config.ts):
# an invalid or missing value stops the process and names the variable.
# Copy to .env (git-ignored) for local development. Never commit real values.

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (ADR 0026, ADR 0046) ---
# A login of sport_performance_worker (`db:provision-login` with DB_LOGIN_ROLE=worker), never
# the owner: the worker refuses to start otherwise. The same login runs pg-boss and the
# listener of the recalculation notifications. Run `db:migrate` (as the owner) first: it
# installs the job queue schema the worker uses.
DATABASE_URL=postgres://sp_worker:change-me@localhost:5432/sport_performance
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=60000
# pg-boss's own pool.
JOB_QUEUE_POOL_MAX=4

# --- Jobs ---
# Clubs recalculated at the same time by this process.
WORKER_CLUB_CONCURRENCY=2
# How long SIGTERM waits for the jobs in progress.
SHUTDOWN_TIMEOUT_MS=30000

# --- Sentry (ADR 0016). Empty = disabled. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=

# --- Bucket of uploaded files (ADR 0044): the daily retention job. All or none; required in
# production. Empty = the job is off (development only).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Notifications (B-328, ADR 0054) ---
# on | off. `off`: nothing is planned or sent (for example, a staging copy of production data).
NOTIFICATIONS=on
# Resend, the same domain as the API's emails. Required in production; empty = the emails are
# written to the log (development only).
RESEND_API_KEY=
EMAIL_FROM=
# The web app, for the links of the emails. Required (https) in production.
WEB_APP_URL=http://localhost:5173
# Expo access token, when the Expo project enables "enhanced security for push notifications".
EXPO_ACCESS_TOKEN=
# Demo clubs (`club.is_demo`, ADR 0055) deliver nothing (skipped as `demo_club`), except to users
# whose email is of one of these comma-separated domains: catch-all mailboxes of staging. Reserved
# domains (example.com, .test, .invalid…) are rejected. Empty = a demo club delivers nothing.
DEMO_NOTIFICATION_EMAIL_DOMAINS=

# --- Operational monitoring (B-703, ADR 0095; runbook docs/ops/monitoreo.md) ---
# on | off. `on`: the `ops-monitor` job measures the operational checks every minute, records
# them for the API's `/health/ops` and announces the failing ones to Sentry (with SENTRY_DSN),
# plus a Sentry Crons check-in. `off`: `/health/ops` reports the worker as down.
OPS_MONITOR=on
# A check that stays failing is announced to Sentry again every this many minutes (5..10080).
OPS_RENOTIFY_MINUTES=60
