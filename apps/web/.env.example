# Environment of apps/web, read by Vite at build time and validated at startup (src/env.ts).
# Copy to .env.local (git-ignored) for local development. Nothing secret goes here: every
# VITE_ variable ends up in the public bundle.

# Origin of the API (apps/api). The API must list this web's origin in its WEB_ORIGINS so the
# session cookie travels (CORS with credentials). https in production.
VITE_API_URL=http://localhost:3000

# --- Image of the web (apps/web/Dockerfile, B-701, ADR 0087) ---
# Read at runtime by apps/web/deploy/entrypoint.sh, not by Vite: VITE_API_URL above (its origin
# goes into the Content-Security-Policy) and the bucket, whose signed URLs the browser uploads
# to and reads from. Not secret: only the endpoint and the bucket name, never the keys.
# Port Caddy listens on (Railway: 8080).
PORT=8080
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=false
