# Environment of apps/web, read by Vite at build time and validated at startup (src/env.ts).
# Copy to .env.local (git-ignored) for local development. Nothing secret goes here: every
# VITE_ variable ends up in the public bundle.

# Origin of the API (apps/api). The API must list this web's origin in its WEB_ORIGINS so the
# session cookie travels (CORS with credentials). https in production.
VITE_API_URL=http://localhost:3000

# --- Image of the web (apps/web/Dockerfile, B-701, ADR 0090) ---
# In the image the web and the API share one origin: VITE_API_URL is the web's own public
# origin and Caddy proxies /v1/* to the API. The session cookie is SameSite=Lax, so a web and an
# API on different sites (Railway's *.up.railway.app domains are on the Public Suffix List)
# could not log in. Locally, localhost:5173 and localhost:3000 are the same site.
# Read at runtime by apps/web/deploy/entrypoint.sh, not by Vite: where the API is and the
# bucket, whose signed URLs the browser uploads to and reads from (its origin goes into the
# Content-Security-Policy). Not secret: only addresses and the bucket name, never the keys.
# Port Caddy listens on (Railway: 8080).
PORT=8080
# Where Caddy proxies /v1/*: the API over the private network (Railway:
# http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080). Only scheme://host[:port].
API_UPSTREAM=http://localhost:3000
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=false
