# Build environment of the mobile app (ADR 0058). Read by `app.config.ts` when the Expo CLI
# builds the config (`expo start`, `expo run:*`, `eas build`, `eas update`). Copy to `.env` for
# local development; EAS sets them per profile (`eas.json` + EAS environment variables).
# Everything here ends up inside the app bundle: never put a secret in these variables.

# development | staging | production. Picks the app id, name, deep link scheme and EAS Update
# channel. Default: development.
APP_VARIANT=development

# Origin of the API. Required (https) for staging and production. Development default:
# http://localhost:3000; on a phone use the LAN IP of the machine running the API
# (http://192.168.x.y:3000) and on the Android emulator http://10.0.2.2:3000.
API_BASE_URL=http://localhost:3000

# Origin of the staff web: its /invite/* and /player-access/* links open the app (Universal
# Links on iOS, App Links on Android). Required (https) for staging and production; optional in
# development. The web must serve apple-app-site-association and assetlinks.json for this host.
WEB_APP_URL=

# UUID of the EAS project (one project, one channel per variant). Without it the app builds and
# runs, but has no EAS Update URL. Set it once the EAS project exists (B-012).
EAS_PROJECT_ID=

# Sentry (ADR 0016). The DSN is public by design. Without it Sentry is not initialized.
SENTRY_DSN=
# Fraction of transactions traced, 0 to 1. Default 0.
SENTRY_TRACES_SAMPLE_RATE=0
# Source map upload by EAS Build. The upload token (SENTRY_AUTH_TOKEN) is an EAS secret, never here.
SENTRY_ORG=
SENTRY_PROJECT=
