    "@sport-performance/i18n": "workspace:*",
    "@sport-performance/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "expo": "58.0.22",
    "expo-application": "58.1.2",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
