{
  "name": "@sport-performance/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Player and staff mobile app (Expo / React Native, offline-first).",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/eas-postinstall.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config": "expo config --type public",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:shots": "node gallery/capture.ts"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "0.4.1",
    "@expo-google-fonts/barlow-condensed": "0.4.1",
    "@formatjs/intl-datetimeformat": "8.0.2",
    "@formatjs/intl-getcanonicallocales": "3.3.0",
    "@formatjs/intl-locale": "5.4.2",
    "@formatjs/intl-numberformat": "10.0.2",
    "@formatjs/intl-pluralrules": "7.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sentry/react-native": "8.28.0",
    "@sport-performance/contracts": "workspace:*",
    "@sport-performance/domain": "workspace:*",
    "@sport-performance/i18n": "workspace:*",
    "@sport-performance/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "drizzle-orm": "0.45.4",
    "expo": "58.0.22",
    "expo-application": "58.1.2",
    "expo-audio": "58.0.11",
    "expo-background-task": "58.0.12",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-network": "58.0.4",
    "expo-notifications": "58.1.7",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-task-manager": "58.0.13",
    "expo-updates": "58.0.20",
    "expo-video-thumbnails": "58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-vision-camera": "5.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sport-performance/config": "workspace:*",
    "@sport-performance/e2e": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "react-dom": "19.3.0",
