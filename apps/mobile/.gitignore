# Generated by the Expo CLI (ADR 0058): native projects come from `expo prebuild` / `expo run`
# (Continuous Native Generation), never edited by hand nor committed.
.expo/
# Anchored: only the app's generated projects, never the sources of the local native
# modules in `modules/*/ios` and `modules/*/android` (ADR 0085).
/ios/
/android/
expo-env.d.ts
# The screen gallery's build and screenshots (ADR 0098): never committed.
/.gallery/
/.gallery-shots/
