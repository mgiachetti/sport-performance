# Environment of apps/api. Validated with zod at startup (src/config/env.ts):
# an invalid or missing value stops the process and names the variable.
# Copy to .env (git-ignored) for local development. Never commit real values.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Proxies in front of the API whose X-Forwarded-* headers are trusted. Railway: 1.
# Required (>= 1) in production: with 0 every request has the proxy's IP and the per-IP
# sign-in limits would be shared by all users. 0 (no proxy) is the default elsewhere.
TRUST_PROXY_HOPS=0
# Largest JSON body (max 10 MiB). Public endpoints that change state take 16 KiB. Files never go
# through the API: they go to the bucket with signed URLs (B-325).
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000

# --- HTTP server (ADR 0031) ---
# Whole request (headers + body) must arrive within this; headers within the next one (<= request).
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
# Idle keep-alive sockets close after this (keep it above the proxy's idle timeout).
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
# A socket without activity for this long is destroyed.
HTTP_CONNECTION_TIMEOUT_MS=60000
HTTP_MAX_CONNECTIONS=2048
# Request line + headers; bigger is answered 431.
HTTP_MAX_HEADER_SIZE_BYTES=16384

# --- General rate limits (ADR 0031) ---
# Per IP and per user, by route class. Cannot be false in production.
RATE_LIMIT_ENABLED=true
# Past this the counter store is considered down and requests go through (fail open).
RATE_LIMIT_TIMEOUT_MS=500

# Required. A login of the sport_performance_app role (ADR 0006, ADR 0026): not the owner,
# no BYPASSRLS. In production its password must be 16+ characters and not an example value. The API checks it at startup and refuses to start otherwise. Create it after
# the migrations with `pnpm --filter @sport-performance/db db:provision-login` (see
# packages/db/README.md). Local example with the Docker postgres:16 of CLAUDE.md:
DATABASE_URL=postgres://sp_api:change-me-local-only@localhost:5432/sport_performance
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
HEALTH_DB_TIMEOUT_MS=2000

# --- Auth (ADR 0010, ADR 0028) ---
# Required. 32+ random characters (`openssl rand -base64 48`). Signs the session cookies and keys
# the attempt counters: rotating it signs every web user out. Never reuse it across environments.
# In production the API refuses short, low-entropy or example-looking values (like this one).
AUTH_SECRET=change-me-to-a-long-random-string-of-48-characters
# Public URL of this API. Default http://localhost:<PORT>. https => Secure __Secure- cookies.
# Required (https) in production.
AUTH_BASE_URL=
# Required. Better Auth's own connection (sessions, codes, attempt counters): a login of the
# sport_performance_auth role (ADR 0026, ADR 0028), never the login of DATABASE_URL. Checked at
# startup like DATABASE_URL. Create it with `DB_LOGIN_ROLE=auth ... db:provision-login`.
AUTH_DATABASE_URL=postgres://sp_auth:change-me-local-only@localhost:5432/sport_performance
AUTH_DATABASE_POOL_MAX=5
SESSION_EXPIRES_IN_DAYS=30
# Comma-separated origins of the web app allowed to use the session cookie (CORS + CSRF).
# Default in development: http://localhost:5173. None in production unless set.
WEB_ORIGINS=http://localhost:5173
# Base of the invitation universal links (<WEB_APP_URL>/invite/<token>). Required (https) in production.
WEB_APP_URL=http://localhost:5173
# Scheme of the Expo app deep links (<scheme>://invite/<token>).
APP_DEEP_LINK_SCHEME=sportperformance

# --- Email (Resend + React Email) ---
# Empty = development transport: emails (and sign-in codes) are written to the log, not sent.
# Required in production.
RESEND_API_KEY=
# Sender on a domain verified in Resend (SPF, DKIM). Required with RESEND_API_KEY.
EMAIL_FROM=

# Version reported by /health and Sentry. Railway sets RAILWAY_GIT_COMMIT_SHA, used when unset.
APP_VERSION=

# Sentry (ADR 0016). Empty DSN = disabled.
SENTRY_DSN=
# Defaults to RAILWAY_ENVIRONMENT_NAME, then NODE_ENV.
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
