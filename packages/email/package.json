{
  "name": "@sport-performance/email",
  "version": "0.0.0",
  "private": true,
  "description": "Email delivery shared by the API and the worker: Resend transport, React Email layout and templates.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0"
  },
  "devDependencies": {
    "@sport-performance/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
