{
  "name": "@sport-performance/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), versioned SQL migrations, migration runner and seeds.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./seeds": {
      "types": "./dist/seeds/index.d.ts",
      "default": "./dist/seeds/index.js"
    },
    "./testing": {
      "types": "./dist/testing/temporary-database.d.ts",
      "default": "./dist/testing/temporary-database.js"
    }
  },
  "bin": {
    "sport-performance-db-migrate": "./dist/cli/migrate.js",
    "sport-performance-db-provision-login": "./dist/cli/provision-login.js",
    "sport-performance-db-seed": "./dist/cli/seed.js",
    "sport-performance-db-seed-demo": "./dist/cli/seed-demo.js",
    "sport-performance-db-release": "./dist/cli/release.js",
    "sport-performance-db-restore": "./dist/cli/restore.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node dist/cli/migrate.js",
    "db:provision-login": "node dist/cli/provision-login.js",
    "db:release": "node dist/cli/release.js",
    "db:restore": "node dist/cli/restore.js",
    "db:seed": "node dist/cli/seed.js",
    "db:seed:demo": "node dist/cli/seed-demo.js"
  },
  "dependencies": {
    "@sport-performance/domain": "workspace:*",
    "@sport-performance/ui-tokens": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@sport-performance/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
