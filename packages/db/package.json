{
  "name": "@sport-performance/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), versioned SQL migrations and migration runner.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "bin": {
    "sport-performance-db-migrate": "./dist/cli/migrate.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node dist/cli/migrate.js"
  },
  "dependencies": {
    "@sport-performance/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@sport-performance/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
