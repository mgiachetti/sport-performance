# @sport-performance/db. Copy to `.env` (never commit it) or export the variables.

# Server for the integration tests: each test file creates (and drops) its own database
# there, runs the migrations as this user and provisions throwaway logins of the
# connection roles, so it must be a superuser. Locally, a Docker `postgres:16`:
#   docker run -d --rm --name pg-dev -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Owner role used by `db:migrate` and `db:provision-login` (superuser or BYPASSRLS, ADR 0026).
# Falls back to DATABASE_URL when unset or empty (local, CI).
MIGRATIONS_DATABASE_URL=

# `db:provision-login`: creates or updates a login as a member of one connection role.
# app = API, worker = worker, auth = Better Auth. Never commit the password.
DB_LOGIN_ROLE=
DB_LOGIN_NAME=
DB_LOGIN_PASSWORD=

# `db:seed:demo` (B-307, ADR 0055): the demo club with fictitious data. Refuses to run unless
# the environment (RAILWAY_ENVIRONMENT_NAME, else NODE_ENV) is local, development, test, ci or
# staging and DEMO_SEED_CONFIRM names that same environment. A database can also refuse it for
# good: `ALTER DATABASE <db> SET app.deployment_environment = 'production'`.
DEMO_SEED_CONFIRM=
# Club slug (starts with `demo`), seed of the data, last day (YYYY-MM-DD, default today in the
# club's zone), days of daily data (default 84) and domain of the demo emails (default
# example.com, which never receives mail; staging may use a catch-all domain of the team).
DEMO_SEED_SLUG=
DEMO_SEED=
DEMO_SEED_AS_OF=
DEMO_SEED_HISTORY_DAYS=
DEMO_EMAIL_DOMAIN=

# `db:restore verify|record` (B-702, ADR 0094): owner URL of the RESTORED database (the sibling
# service a PITR restore creates). No default on purpose: it must never point at the source.
# `db:restore mark` writes on the source with MIGRATIONS_DATABASE_URL (or DATABASE_URL).
RESTORE_DATABASE_URL=
