# @sport-performance/db. Copy to `.env` (never commit it) or export the variables.

# Application role: used by the API and the worker (no table ownership, no BYPASSRLS, #33).
# Integration tests create throwaway databases on this server, so locally it can point at
# a Docker `postgres:16`:
#   docker run -d --rm --name pg-dev -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Table-owner role used by `db:migrate`. Falls back to DATABASE_URL when unset (local, CI).
MIGRATIONS_DATABASE_URL=
