# @sport-performance/db. Copy to `.env` (never commit it) or export the variables.

# Server for the integration tests: each test file creates (and drops) its own database
# there, runs the migrations as this user and provisions throwaway logins of the
# connection roles, so it must be a superuser. Locally, a Docker `postgres:16`:
#   docker run -d --rm --name pg-dev -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Owner role used by `db:migrate` and `db:provision-login` (superuser or BYPASSRLS, ADR 0025).
# Falls back to DATABASE_URL when unset or empty (local, CI).
MIGRATIONS_DATABASE_URL=

# `db:provision-login`: creates or updates a login as a member of one connection role.
# app = API, worker = worker, auth = Better Auth. Never commit the password.
DB_LOGIN_ROLE=
DB_LOGIN_NAME=
DB_LOGIN_PASSWORD=
