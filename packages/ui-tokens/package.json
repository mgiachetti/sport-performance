{
  "name": "@sport-performance/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens (palette, typography, status) with per-club runtime theming.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sport-performance/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
