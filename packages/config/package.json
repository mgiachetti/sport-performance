{
  "name": "@sport-performance/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Vitest configuration for the monorepo.",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/bundler.json": "./tsconfig/bundler.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
