/*
 * Bench setup on the nRF52840 DK (PCA10056) before the pod v0 PCB exists:
 * LC29H breakout, Ebyte E22-900M22S, LSM6DSV320X evaluation board and a W25N
 * breakout wired to the DK headers. The wiring table is in firmware/README.md
 * ("Cableado del DK"); keep both in sync.
 *
 * Differences with the pod: the console stays on UARTE0 (J-Link VCOM) and the
 * GNSS goes to UARTE1; button 1 stands in for the Hall sensor (pressed = in the
 * vest) and LEDs 1–3 for the RGB LED. There is no load switch, charger nor
 * fuel gauge unless their breakouts are wired to the I2C header.
 */

#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
	zephyr,user {
		gnss-uart = <&uart1>;
		gnss-en-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;	/* D3 → EN of the breakout (or unwired) */
		gnss-reset-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;	/* D4 → NMOS gate to RESET_N */
		gnss-wakeup-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;	/* D5 → WAKEUP */
		gnss-pps-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;	/* D2 ← 1PPS */
		hall-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* button 1 */
		button-gpios = <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* button 2 */
	};

	pwmleds {
		compatible = "pwm-leds";

		led_red: led_red {
			pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_INVERTED>;	/* LED1 */
		};
		led_green: led_green {
			pwms = <&pwm0 1 PWM_USEC(1000) PWM_POLARITY_INVERTED>;	/* LED2 */
		};
		led_blue: led_blue {
			pwms = <&pwm0 2 PWM_USEC(1000) PWM_POLARITY_INVERTED>;	/* LED3 */
		};
	};

	aliases {
		led-red = &led_red;
		led-green = &led_green;
		led-blue = &led_blue;
	};
};

&pinctrl {
	pod_uart1_default: pod_uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>;	/* D1 → LC29H RXD (2,8 V: translator) */
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>;	/* D0 ← LC29H TXD (2,8 V: translator) */
			bias-pull-up;
		};
	};

	pod_uart1_sleep: pod_uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RX, 1, 1)>;
			low-power-enable;
		};
	};

	pod_spi1_default: pod_spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,	/* A5 */
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,	/* A4 */
				<NRF_PSEL(SPIM_MISO, 0, 29)>;	/* A3 */
		};
	};

	pod_spi1_sleep: pod_spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 30)>,
				<NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
		};
	};

	pod_spi2_default: pod_spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,	/* D13 */
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,	/* D11 */
				<NRF_PSEL(SPIM_MISO, 1, 14)>;	/* D12 */
		};
	};

	pod_spi2_sleep: pod_spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};

	pod_spi3_default: pod_spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,	/* D6 */
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,	/* D7 */
				<NRF_PSEL(SPIM_MISO, 1, 9)>;	/* P1.09 (P24 header) */
		};
	};

	pod_spi3_sleep: pod_spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,
				<NRF_PSEL(SPIM_MISO, 1, 9)>;
			low-power-enable;
		};
	};

	pod_pwm0_default: pod_pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,	/* LED1 */
				<NRF_PSEL(PWM_OUT1, 0, 14)>,	/* LED2 */
				<NRF_PSEL(PWM_OUT2, 0, 15)>;	/* LED3 */
		};
	};

	pod_pwm0_sleep: pod_pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 0, 14)>,
				<NRF_PSEL(PWM_OUT2, 0, 15)>;
			low-power-enable;
		};
	};
};

/* GNSS on UARTE1 (the console keeps UARTE0 on the J-Link VCOM). */
&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&pod_uart1_default>;
	pinctrl-1 = <&pod_uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Arduino I2C header: BMP581, MAX17048 and BQ25180 breakouts if wired. */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	charger: bq25180@6a {
		compatible = "ti,bq25180";
		reg = <0x6a>;
		status = "disabled";
	};

	fuel_gauge: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
		status = "disabled";
	};

	baro: bmp581@47 {
		compatible = "bosch,bmp581";
		reg = <0x47>;
	};
};

/* LSM6DSV320X evaluation board. */
&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&pod_spi1_default>;
	pinctrl-1 = <&pod_spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;	/* A2 */

	imu: lsm6dsv320x@0 {
		compatible = "st,lsm6dsv320x";
		reg = <0>;
		spi-max-frequency = <8000000>;
		int1-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;	/* P0.02 (AREF pin) */
	};
};

/* E22-900M22S. */
&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&pod_spi2_default>;
	pinctrl-1 = <&pod_spi2_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;	/* D10 → NSS */

	lora: e22@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;	/* A0 → NRST */
		busy-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;	/* D9 ← BUSY */
		dio1-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;	/* D8 ← DIO1 */
		rx-enable-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;	/* A1 → RXEN */
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
	};
};

/* W25N breakout (the DK's own QSPI NOR stays on its QSPI pins). */
&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&pod_spi3_default>;
	pinctrl-1 = <&pod_spi3_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;	/* P1.00 (P24 header) */

	nand: w25n04kv@0 {
		compatible = "winbond,w25n04kv";
		reg = <0>;
		spi-max-frequency = <8000000>;
		blocks = <4096>;
		pages-per-block = <64>;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pod_pwm0_default>;
	pinctrl-1 = <&pod_pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&wdt0 {
	status = "okay";
};
