/*
 * Pod v0 (B-909): u-blox BMD-340 (nRF52840), LC29H, Ai-Thinker Ra-01SH (SX1262),
 * LSM6DSV32X, W25N02KV, BQ25180, MAX17048, BMP581 (in-stock redesign of
 * 09/11/2026). Every pin comes from docs/hardware/pod-v0.md ("Pines del
 * nRF52840"); keep both in sync. The nRF52840 port pins are the same as with
 * the Raytac module: only the module pads in the comments changed.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "pod_v0_nrf52840-pinctrl.dtsi"

/ {
	model = "sport-performance pod v0 (nRF52840)";
	compatible = "sport-performance,pod-v0";

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash = &flash0;
		zephyr,sram = &sram0;
	};

	/*
	 * Application GPIOs without a Zephyr driver (read by app/src/*.c with
	 * GPIO_DT_SPEC_GET_OR). Every enable has a 100 kΩ pull-down on the board,
	 * so the rails stay off during reset, DFU and the System OFF wake-up.
	 */
	zephyr,user {
		gnss-uart = <&uart0>;
		/* EN of the 3,2 V LDO of the GNSS (active discharge): the GNSS power cut. */
		gnss-en-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;	/* GNSS_EN, pad 62 */
		/* NPN/NMOS open drain to RESET_N: high here = module in reset (≥ 100 ms). */
		gnss-reset-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;	/* GNSS_RST, pad 19 */
		/* WAKEUP (3,0–3,6 V high): ≥ 10 ms pulse out of backup, input otherwise. */
		gnss-wakeup-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;	/* GNSS_WAKEUP, pad 25 (NFC1) */
		/* 1PPS: GPIOTE → PPI → TIMER capture (app/src/time_base.c). */
		gnss-pps-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;	/* pad 53 */
		/* DRV5032FA (or FB) push-pull through a series resistor: low = pod in the vest. */
		hall-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;	/* HALL_INT, pad 26 (NFC2) */
		/* BQ25180 /INT, open drain, 128 µs pulse. */
		chg-int-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* pad 54 */
		/* MAX17048 /ALRT, open drain. */
		fg-alrt-gpios = <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* pad 63 */
		/* Bench button to GND. */
		button-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* pad 64 */
		/* ON of the TPS22919 load switch of the Ra-01SH (U303). */
		lora-en-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;	/* LORA_EN, pad 57 */
		/* ADXL372 INT1 (not mounted) or NAND_EN by 0 Ω: one or the other. */
		hg-int-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;	/* pad 59 */
		/* DWM3000 (not mounted). */
		uwb-irq-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;	/* pad 58 */
		uwb-reset-gpios = <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;	/* pad 50 */
		uwb-wakeup-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;	/* pad 48 */
		/* Divider from SYS (not mounted) on AIN4: rescue if the MAX17048 fails. */
		io-channels = <&adc 4>;	/* VBAT_ADC = P0.28, pad 9 */
	};

	pwmleds {
		compatible = "pwm-leds";

		led_red: led_red {
			pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
		led_green: led_green {
			pwms = <&pwm0 1 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
		led_blue: led_blue {
			pwms = <&pwm0 2 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
	};

	aliases {
		watchdog0 = &wdt0;
		led-red = &led_red;
		led-green = &led_green;
		led-blue = &led_blue;
	};
};

/*
 * REG0 (the VDDH stage) is not used: VDD and VDDH both on VREG (normal voltage
 * mode) and DCCH unconnected (pod-v0.md), so its DC/DC stays off. No &reg0 node.
 */

/*
 * VCC and VCCH of the BMD-340 tied to VREG (3,4 V): LV (normal) mode of its data
 * sheet (table 8), DC/DC of Reg1 on (inductor inside the module).
 */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

/*
 * UICR, written at the first programming (production step, B-909): NFC pads
 * P0.09/P0.10 as GPIO (GNSS WAKEUP and Hall) and P0.18 as nRESET.
 */
&uicr {
	nfct-pins-as-gpios;
	gpio-as-nreset;
};

&nfct {
	status = "disabled";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	/* XL1/XL2 carry the 32,768 kHz crystal; P0.18 is nRESET. */
	gpio-reserved-ranges = <0 2>, <18 1>;
};

&gpio1 {
	status = "okay";
};

&adc {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

/* GNSS, 921600 bps by default (lc29h-protocolo.md); the driver falls back to 115200. */
&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <921600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Backup console. */
&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	/* The application writes its registers itself (pod/power.h): the Zephyr driver stays off. */
	charger: bq25180@6a {
		compatible = "ti,bq25180";
		reg = <0x6a>;
	};

	/* VDD and CELL on the cell: measures even with SYS cut. Address not verified. */
	fuel_gauge: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};

	/* SDO to VDDIO (0x47), CSB to VDDIO (I2C), INT open drain active low. Not verified. */
	baro: bmp581@47 {
		compatible = "bosch,bmp581";
		reg = <0x47>;
		int-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;	/* BARO_INT, pad 61 */
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>,	/* IMU_CS, pad 52 */
		   <&gpio0 27 GPIO_ACTIVE_LOW>,	/* UWB_CS, pad 8 (static CS) */
		   <&gpio0 26 GPIO_ACTIVE_LOW>;	/* HG_CS, pad 7 (static CS) */

	/*
	 * LSM6DSV32X (WHO_AM_I 0x70): driven by the lsm6dsv16x driver of NCS 3.4.1
	 * (compatible st,lsm6dsv32x). Channel 1 at ±16 g for the run; the second
	 * channel, fixed at ±32 g, is read by imu_batch (firmware/README.md).
	 */
	imu: lsm6dsv32x@0 {
		compatible = "st,lsm6dsv32x";
		reg = <0>;
		spi-max-frequency = <8000000>;
		accel-range = <16>;
		int1-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;	/* IMU_INT1, pad 60: motion wake-up */
		int2-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;	/* IMU_INT2, pad 49 */
	};

	/*
	 * ADXL372 (±200 g, U403): mounted only on the pod-v0-highg assembly variant
	 * (2 of the 5 v0 boards). Enable it there with boards/pod_v0_highg.overlay.
	 */
	hg_accel: adxl372@2 {
		compatible = "adi,adxl372";
		reg = <2>;
		spi-max-frequency = <8000000>;
		int1-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;	/* HG_INT, pad 59 */
		status = "disabled";
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;	/* LORA_NSS, pad 34 */

	/*
	 * Ai-Thinker Ra-01SH: plain crystal, no TCXO (no dio3-tcxo-voltage). Its RF
	 * switch follows DIO2 inside the module (TXEN tied to DIO2, module schematic);
	 * RXEN is driven anyway, high to receive. Frequency error checked on the
	 * bench (pod-v0.md); fallback with TCXO: NiceRF LoRa1262-915TCXO.
	 */
	lora: ra01sh@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;	/* LORA_NRST, pad 12 */
		busy-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;	/* LORA_BUSY, pad 15 */
		dio1-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;	/* LORA_DIO1, pad 10 */
		rx-enable-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;	/* LORA_RXEN, pad 11 */
		dio2-tx-enable;
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;	/* NAND_CS, pad 35 */
	/* Errata 198: the SPIM3 buffers live in their own RAM block (app/src/log_nand.c). */

	nand: w25n02kv@0 {
		compatible = "winbond,w25n02kv";
		reg = <0>;
		spi-max-frequency = <32000000>;
		blocks = <2048>;
		pages-per-block = <64>;
		jedec-device-id = <0xaa22>;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Buzzer, not mounted. */
&pwm1 {
	status = "disabled";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Flash layout, pinned here (no Partition Manager, SB_CONFIG_PARTITION_MANAGER=n):
 * MCUboot, two application slots of 472 KB for the swap (ADR 0106: about
 * 450 KB each) and the NVS of the persistent counters at the end. Changing
 * these addresses in an update would lose the boot counter and the page
 * sequence reservation: never move `storage_partition`.
 */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0x0000c000>;
		};
		slot0_partition: partition@c000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0000c000 0x00076000>;
		};
		slot1_partition: partition@82000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00082000 0x00076000>;
		};
		storage_partition: partition@f8000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};

/* USB through the dock pads (D+/D- pads 68/67, VBUS pad 66 after the input switch). */
zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};
