# Pod v0 (nRF52840) defaults.

CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# 32,768 kHz crystal mounted on XL1/XL2 (pod-v0.md): the LFXO is the record tick and the BLE clock.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# The main console is RTT over the Tag-Connect; UARTE1 is the backup console pad.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
