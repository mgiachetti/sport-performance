(version 1)
# Reglas propias del pod v0 (B-909). Las clases de red (RF_50, USB_90D, POWER_DOCK, POWER,
# SW_NODE, GNSS_SENSITIVE) y los mínimos de la placa están en pod-v0.kicad_pro; el apilado, en
# pod-v0.kicad_pcb; qué es cada cosa y qué falta confirmar, en hardware/README.md.
#
# En KiCad, cuando varias reglas definen la misma restricción para un par de objetos, gana la
# última que coincide, y cualquier regla propia gana sobre las clases de red. Por eso el mínimo
# general de separación de PCBWay (0,1 mm) está en el Board Setup (min_clearance, que es un piso)
# y no como regla sin condición: una regla así pisaría la separación de 0,2 mm de RF_50, que es
# la separación coplanar de la línea de 50 ohm.

# --- Mínimos de PCBWay para 4 capas (no verificados contra su página de capacidades) ---
(rule "PCBWay: ancho mínimo de pista"
	(constraint track_width (min 0.1mm)))
(rule "PCBWay: anillo mínimo"
	(constraint annular_width (min 0.15mm)))
(rule "PCBWay: agujero mínimo"
	(constraint hole_size (min 0.2mm)))
(rule "PCBWay: diámetro mínimo de vía"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm)))
(rule "PCBWay: agujero a agujero"
	(constraint hole_to_hole (min 0.25mm)))
(rule "PCBWay: cobre al borde"
	(constraint edge_clearance (min 0.3mm)))
(rule "PCBWay: serigrafía a pads"
	(layer "?.Silkscreen")
	(constraint silk_clearance (min 0.15mm)))

# --- L2: plano de tierra continuo en toda la placa ---
# Solo GND en In1.Cu: ni pistas ni zonas de otras redes (las vías lo cruzan con su antipad).
# Sin red solo quedan las rule areas, que también pasan por L2: no cuentan.
(rule "L2 solo GND"
	(layer "In1.Cu")
	(condition "A.NetName != 'GND' && A.NetName != ''")
	(constraint disallow track zone))

# --- Pads de RF_50 y GNSS_SENSITIVE ---
# Las clases RF_50 (0,5 mm) y GNSS_SENSITIVE (0,3 mm) separan pistas, vías y zonas. Entre dos
# pads (el 0 Ω entre dos tramos de RF, el bias-T, los pines de un SOT-23 o del módulo) vale el
# mínimo de la clase Default. KiCad no tiene una condición confiable de "mismo componente", así
# que esto vale para cualquier par de pads; las reglas que siguen (GND, SW_NODE) ganan sobre esta.
(rule "RF_50 y GNSS_SENSITIVE: entre pads"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && (A.NetClass == 'RF_50' || A.NetClass == 'GNSS_SENSITIVE')")
	(constraint clearance (min 0.15mm)))

# --- RF_50: línea coplanar de 50 ohm con tierra en L1, referida a la tierra de L2 ---
# 0,33 mm con 0,20 mm de separación a la tierra de L1: 52,3 ohm sin máscara y unos 51 ohm con la
# máscara (estimación) con el apilado provisorio (hardware/tools/impedancia.py). El rango de
# 0,31 a 0,35 mm cubre el ajuste que pida la calculadora de PCBWay (SI9000); con su geometría se
# fija el ancho de la clase y se cierra este rango.
(rule "RF_50: ancho de 50 ohm en L1"
	(layer "F.Cu")
	(condition "A.NetClass == 'RF_50'")
	(constraint track_width (min 0.31mm) (opt 0.33mm) (max 0.35mm)))
(rule "RF_50: solo en L1 (internas)"
	(layer inner)
	(condition "A.NetClass == 'RF_50'")
	(constraint disallow track))
# Excepción: la alimentación del patch pasivo (GNSS_ANT_PATCH) sale por L4 desde el pad de 2,2 mm
# del pin (la cerámica tapa L1 y su tierra) y sube a L1 por una vía de RF, con vías de GND alrededor
# y L3 en GND debajo del tramo de L4 (eso no se puede escribir como regla: se revisa a mano).
(rule "RF_50: solo en L1 (L4)"
	(layer "B.Cu")
	(condition "A.NetClass == 'RF_50' && A.NetName != '/gnss_rf/GNSS_ANT_PATCH'")
	(constraint disallow track))
# Sin vías en la RF: las únicas vías cerca son las de cerco, que son de GND (salvo la del patch).
(rule "RF_50: sin vías"
	(condition "A.Type == 'Via' && A.NetClass == 'RF_50' && A.NetName != '/gnss_rf/GNSS_ANT_PATCH'")
	(constraint disallow via))
# La ranura coplanar: gana sobre los 0,5 mm de la clase, así la zona de GND de L1 se rellena
# a 0,20 mm de la RF.
(rule "RF_50: separación coplanar a GND"
	(condition "A.NetClass == 'RF_50' && B.NetName == 'GND'")
	(constraint clearance (min 0.2mm)))
# Pistas, vías y zonas de otras redes lejos de la RF (lo mismo que la clase, explícito).
(rule "RF_50: otras redes lejos"
	(condition "A.NetClass == 'RF_50' && B.Type != 'Pad' && B.NetClass != 'RF_50' && B.NetName != 'GND'")
	(constraint clearance (min 0.5mm)))

# --- USB_90D: par diferencial de 90 ohm (D+ y D− de la base al nRF, 12 Mbit/s) ---
(rule "USB_90D: geometría del par"
	(condition "A.NetClass == 'USB_90D' && A.inDiffPair('*')")
	(constraint track_width (min 0.23mm) (opt 0.25mm) (max 0.27mm))
	(constraint diff_pair_gap (min 0.14mm) (opt 0.15mm) (max 0.2mm))
	(constraint diff_pair_uncoupled (max 5mm))
	(constraint skew (max 0.5mm)))

# --- Alimentación ---
# 1 A de la base por VBUS, SYS y BAT: 0,5 mm en las capas externas (35 µm). En las internas
# (17,5 µm) IPC-2221 pide unos 1,5 mm para 1 A con 10 °C de aumento: mejor por L1/L4 o con zonas.
(rule "POWER_DOCK: ancho en capas internas"
	(layer inner)
	(condition "A.NetClass == 'POWER_DOCK'")
	(constraint track_width (min 1.5mm)))

# --- Nodo de conmutación del buck-boost (BB_LX1, BB_LX2) ---
(rule "SW_NODE: lejos de la RF y del GNSS"
	(condition "A.NetClass == 'SW_NODE' && (B.NetClass == 'RF_50' || B.NetClass == 'GNSS_SENSITIVE')")
	(constraint clearance (min 5mm)))
(rule "SW_NODE: fuera de las zonas de antena"
	(condition "A.NetClass == 'SW_NODE' && (A.intersectsArea('GNSS_ANTENA') || A.intersectsArea('LORA_ANTENA') || A.intersectsArea('BLE_ANTENA'))")
	(constraint disallow track via pad zone))

# --- GNSS_SENSITIVE: PPS, UART del GNSS, bias de la antena y cristal de 32,768 kHz ---
(rule "GNSS_SENSITIVE: otras señales lejos"
	(condition "A.NetClass == 'GNSS_SENSITIVE' && B.Type != 'Pad' && B.NetClass != 'GNSS_SENSITIVE' && B.NetName != 'GND'")
	(constraint clearance (min 0.3mm)))
(rule "GNSS_SENSITIVE: fuera de la zona de LoRa"
	(condition "A.NetClass == 'GNSS_SENSITIVE' && A.intersectsArea('LORA_ANTENA')")
	(constraint disallow track via))

# --- Zona de la antena GNSS (patch pasivo en la placa; la Taoglas va por U.FL) ---
# Tierra continua en L1 (y en L2, por "L2 solo GND"): en L1 solo GND y la RF. Las vías pasan
# por L1, así que adentro solo hay vías de GND; L3 y L4 pueden pasar por debajo sin cambiar de
# capa. Ningún componente en la cara de arriba, salvo el patch en la placa (AE201, montado).
(rule "GNSS_ANTENA: solo GND y RF en L1"
	(layer "F.Cu")
	(condition "A.intersectsArea('GNSS_ANTENA') && A.NetName != 'GND' && A.NetClass != 'RF_50'")
	(constraint disallow track via zone))
(rule "GNSS_ANTENA: sin componentes debajo de la antena"
	(layer "F.Cu")
	(condition "A.intersectsArea('GNSS_ANTENA') && A.Reference != 'AE201'")
	(constraint disallow footprint))
